widget "pipboy" {
  page: 1
  order: 3
  size: 3x4
  minSize: 3x3
  meta {
    description: "Pip-Boy style system readout: classic and theme-colored phosphor, CRT scanlines, segmented gauges and STAT/INV/DATA tabs, with or without Linux"
    version: "1.1"
    license: "MIT"
    category: "system"
    owl: 5
  }

  // The phone, from Android: works without Linux.
  source dev = android.device
  source sys = android.system every 5s
  source bat = android.battery
  // The Arch side, once Linux is installed. Base tools only (coreutils, grep, bash, pacman),
  // so it doesn't make the widget need Linux.
  source lx = cmd("""
    . /etc/os-release
    printf '{"os":"%s","pkgs":%s,"explicit":%s,"user":"%s","shell":"%s","upgraded":"%s"}' \
      "$PRETTY_NAME" "$(pacman -Qq | wc -l)" "$(pacman -Qqe | wc -l)" "$(id -un)" \
      "$(basename "$SHELL") $(bash --version | head -1 | cut -d' ' -f4 | cut -d'(' -f1)" \
      "$(grep -a 'starting full system upgrade' /var/log/pacman.log 2>/dev/null | tail -1 | cut -c2-11)"
  """) every 5m json optional

  state phosphor = "green" persist
  state textScale = 1 persist
  state tab = "stat"

  // Classic CRT palettes and colors that follow the active launcher theme.
  let themed = phosphor != "green" && phosphor != "amber"
  let themeInk = phosphor == "red" ? red : phosphor == "yellow" ? yellow : phosphor == "blue" ? blue : phosphor == "magenta" ? magenta : phosphor == "cyan" ? cyan : phosphor == "orange" ? orange : phosphor == "theme-green" ? green : accent
  let amber = phosphor == "amber"
  let hi = themed ? foreground : amber ? "#ffd27f" : "#c8ffd9"
  let main = themed ? themeInk : amber ? "#ffb03b" : "#39ff88"
  let dim = themed ? mix(background, themeInk, 0.75) : amber ? "#c9871a" : "#2fae62"
  let edge = themed ? mix(background, themeInk, 0.4) : amber ? "#7a4d08" : "#1a6b3c"
  let panel = themed ? mix(background, themeInk, 0.1) : amber ? "#221503" : "#0a1c10"
  let bg = themed ? background : amber ? "#120b01" : "#061009"
  let alarm = "#ff5555"
  let caution = "#ffd166"

  // Everything on the tile scales with its height, so the layout fills the tile
  // whether it's on the small cover screen or the big one, or resized.
  let t = clamp((tileHeight ?? 200) / 141, 0.5, 2.8)

  let host = lower(replace(dev.model ?? "phone", " ", "-"))
  let user = lx.user ?? "user"
  let mem = sys.memory
  let disk = sys.storage
  let shown = sys.display
  let memPct = mem == null ? null : mem.used / mem.total * 100
  let diskPct = disk == null ? null : disk.used / disk.total * 100
  let batPct = bat.level
  let batTint = bat == null ? main : bat.level <= 15 ? alarm : bat.level <= 30 ? caution : main

  padding: 3
  background: bg
  onTap: screen()

  // ── shared parts: the tile and the screen use the same components, so their
  //    copy and layout can't drift apart. One label per concept, matching the
  //    fetch widget's vocabulary where they show the same thing.
  component Head(label, size = 10) {
    Column {
      gap: size * 0.35
      fill: width
      Text { text: "[ ${upper(label)} ]"; fontSize: (size) * textScale; font: mono; bold: true; color: main; maxLines: 1 }
      Spacer { height: max(size * 0.12, 1); fill: width; background: edge }
    }
  }

  component Line(key, value, keyW = 110, size = 10) {
    Row {
      gap: size * 0.6
      Text { text: key; fontSize: (size) * textScale; font: mono; color: dim; width: keyW * textScale; maxLines: 1 }
      Text { text: value; fontSize: (size) * textScale; font: mono; color: hi; maxLines: 1; weight: 1 }
    }
  }

  component Gauge(label, pct, tint = main, keyW = 110, size = 10) {
    Row {
      gap: size * 0.6
      align: center
      Text { text: label; fontSize: (size) * textScale; font: mono; color: dim; width: keyW * textScale; maxLines: 1 }
      Canvas {
        height: size * 1.2
        weight: 1
        let n = 16
        let w = width / n
        let on = pct == null ? -1 : clamp(pct, 0, 100) / 100 * n
        for i in range(n) {
          rect(i * w + 1, 1, w - 2, height - 2, fill: i < on ? tint : alpha(main, 0.16))
        }
      }
      Text { text: pct == null ? "…" : "${round(pct)}%"; fontSize: (size) * textScale; font: mono; color: tint; width: size * 2.8 * textScale; align: end; maxLines: 1 }
    }
  }

  component Tab(name, label, size = 11) {
    Text {
      text: label
      fontSize: (size) * textScale
      font: mono
      bold: true
      color: tab == name ? bg : dim
      background: tab == name ? main : panel
      border: 1
      borderColor: edge
      radius: 3
      padding: [0, size * 0.5]
      align: center
      weight: 1
      maxLines: 1
      onTap: tab = name
    }
  }

  component Tabs(size = 11) {
    Row {
      gap: size * 0.55
      fill: width
      Tab { name: "stat"; label: "STAT"; size: size }
      Tab { name: "inv"; label: "INV"; size: size }
      Tab { name: "data"; label: "DATA"; size: size }
    }
  }

  // The Pip-Boy's monitor glyph.
  component Icon(w = 30, h = 34) {
    Canvas {
      width: w
      height: h
      let lw = max(w, h) / 12
      rect(width * 0.08, height * 0.06, width * 0.84, height * 0.56, radius: lw, stroke: main, width: lw)
      line(width / 2, height * 0.62, width / 2, height * 0.8, stroke: main, width: lw)
      line(width * 0.26, height * 0.9, width * 0.74, height * 0.9, stroke: main, width: lw)
    }
  }

  component Phosphor(size = 10, chipW = 76) {
    Text {
      text: phosphor == "theme-green" ? "T.GREEN" : upper(phosphor)
      fontSize: (size) * textScale
      font: mono
      bold: true
      color: bg
      background: main
      border: 1
      borderColor: edge
      radius: 3
      padding: [size * 0.55, size * 0.3]
      width: chipW * textScale
      align: center
      maxLines: 1
      onTap: phosphor = phosphor == "green" ? "amber" : phosphor == "amber" ? "accent" : phosphor == "accent" ? "red" : phosphor == "red" ? "yellow" : phosphor == "yellow" ? "blue" : phosphor == "blue" ? "magenta" : phosphor == "magenta" ? "cyan" : phosphor == "cyan" ? "orange" : phosphor == "orange" ? "theme-green" : "green"
    }
  }

  // The three tabs' content, written once for tile and screen alike.
  component TabBody(keyW = 110, size = 10) {
    if tab == "stat" {
      Head { label: "vitals"; size: size }
      Gauge { label: "battery"; pct: batPct; tint: batTint; keyW: keyW; size: size }
      Gauge { label: "memory"; pct: memPct; tint: memPct > 85 ? alarm : main; keyW: keyW; size: size }
      Gauge { label: "storage"; pct: diskPct; tint: diskPct > 90 ? alarm : main; keyW: keyW; size: size }
      Head { label: "status"; size: size }
      Line { key: "user"; value: "${user}@${host}"; keyW: keyW; size: size }
      Line { key: "os"; value: linux ? lx.os : dev == null ? null : "Android ${dev.android}"; keyW: keyW; size: size }
      Line { key: "kernel"; value: sys.kernel; keyW: keyW; size: size }
      Line { key: "uptime"; value: sys.uptime == null ? null : fmtDuration(sys.uptime); keyW: keyW; size: size }
      Line { key: "packages"; value: linux ? (lx.pkgs == null ? null : "${lx.pkgs} (pacman), ${sys.apps} (apps)") : "${sys.apps} (apps)"; keyW: keyW; size: size }
      if linux {
        Line { key: "shell"; value: lx.shell; keyW: keyW; size: size }
      } else {
        Line { key: "display"; value: shown.width == null ? null : "${shown.width}x${shown.height} @ ${shown.hz}Hz"; keyW: keyW; size: size }
      }
      Text { text: "RADS 0 RAD · CONDITION NOMINAL · WELCOME BACK, ${upper(user)}"; fontSize: (size) * textScale; font: mono; color: dim; maxLines: 1 }
    } else if tab == "inv" {
      Head { label: "hardware"; size: size }
      Line { key: "host"; value: dev == null ? null : "${dev.maker} ${dev.model} (${sys.codename})"; keyW: keyW; size: size }
      Line { key: "cpu"; value: sys.cpu == null ? null : trim("${sys.cpu.maker} ${sys.cpu.soc == "" ? sys.cpu.hardware : sys.cpu.soc}"); keyW: keyW; size: size }
      Line { key: "cores"; value: sys.cpu == null ? null : "${sys.cpu.cores} · ${sys.cpu.abi}${!sys.cpu.maxMhz ? "" : " · up to ${fixed(sys.cpu.maxMhz / 1000, 2)} GHz"}"; keyW: keyW; size: size }
      Line { key: "display"; value: shown.width == null ? null : "${shown.width}x${shown.height} @ ${shown.hz}Hz · ${shown.dpi} dpi"; keyW: keyW; size: size }
      Line { key: "android"; value: dev == null ? null : "${dev.android} (sdk ${dev.sdk})"; keyW: keyW; size: size }
      Line { key: "build"; value: sys.build; keyW: keyW; size: size }
      Head { label: "loadout"; size: size }
      Gauge { label: "memory"; pct: memPct; tint: memPct > 85 ? alarm : main; keyW: keyW; size: size }
      Gauge { label: "storage"; pct: diskPct; tint: diskPct > 90 ? alarm : main; keyW: keyW; size: size }
      Line { key: "apps"; value: sys.apps == null ? null : "${sys.apps} android apps${linux && lx.pkgs != null ? " · ${lx.pkgs} packages" : ""}"; keyW: keyW; size: size }
    } else {
      Head { label: "battery"; size: size }
      Gauge { label: "battery"; pct: batPct; tint: batTint; keyW: keyW; size: size }
      Line { key: "status"; value: bat == null ? null : "${bat.status}${bat.plugged == null ? "" : " (" + bat.plugged + ")"}"; keyW: keyW; size: size }
      Line { key: "temperature"; value: bat.temp == null ? null : "${fixed(bat.temp, 1)}°C"; keyW: keyW; size: size }
      Line { key: "voltage"; value: bat.voltage == null ? null : "${fixed(bat.voltage, 2)} V"; keyW: keyW; size: size }
      Line { key: "health"; value: bat.health ?? "unknown"; keyW: keyW; size: size }
      if bat.cycles != null {
        Line { key: "cycles"; value: bat.cycles; keyW: keyW; size: size }
      }
      if bat.technology != null {
        Line { key: "technology"; value: bat.technology; keyW: keyW; size: size }
      }
      Head { label: "system"; size: size }
      Line { key: "locale"; value: sys.locale == null ? null : "${sys.locale} · ${sys.timezone}"; keyW: keyW; size: size }
      Line { key: "security"; value: sys.patch; keyW: keyW; size: size }
      Line { key: "version"; value: sys.launcher; keyW: keyW; size: size }
      Line { key: "theme"; value: sys.theme ?? "default"; keyW: keyW; size: size }
      Head { label: "linux"; size: size }
      if linux {
        Line { key: "os"; value: lx.os; keyW: keyW; size: size }
        Line { key: "packages"; value: lx.pkgs == null ? null : "${lx.pkgs} (${lx.explicit} explicit)"; keyW: keyW; size: size }
        Line { key: "shell"; value: lx.shell; keyW: keyW; size: size }
        Line { key: "upgraded"; value: lx.upgraded == "" ? "never" : lx.upgraded; keyW: keyW; size: size }
      } else {
        Text { text: "NOT INSTALLED. ARCH LINUX ARM ADDS A TERMINAL, AGENTS AND PACMAN TO THE LAUNCHER."; fontSize: (size) * textScale; font: mono; color: dim; maxLines: 2 }
        Row {
          justify: end
          Text {
            text: "INSTALL LINUX"
            fontSize: (size) * textScale
            font: mono
            bold: true
            color: bg
            background: main
            border: 1
            borderColor: edge
            radius: 3
            padding: [8, 4]
            width: size * 10
            align: center
            maxLines: 1
            onTap: launcher("linux")
          }
        }
      }
    }
  }

  // CRT dressing: static scanlines and vignette, then a slow scan sweep.
  component Scanlines() {
    Canvas {
      let rows = floor(height / 3)
      for i in range(rows) {
        line(0, i * 3 + 1, width, i * 3 + 1, stroke: alpha("#000000", 0.18), width: 1)
      }
      rect(0, 0, width, height, fill: radial(width / 2, height / 2, max(width, height) * 0.9, [alpha("#000000", 0), alpha("#000000", 0.35)]))
    }
  }

  component Sweep() {
    Canvas {
      let y = (time * 40) % (height + 100) - 100
      rect(0, y, width, 80, fill: linear(0, y, 0, y + 80, [alpha(main, 0), alpha(main, 0.08), alpha(main, 0)]))
    }
  }

  component Cursor(k = 1) {
    Canvas {
      width: 6 * k
      height: 8 * k
      if sin(time * 3.5) > -0.3 {
        rect(0, k, 6 * k, 7 * k, fill: main)
      }
    }
  }

  // ── the tile: a Pip-Boy screen ──
  Box {
    fill: true
    background: bg
    border: 2
    borderColor: edge
    radius: 6
    clip: true
    Column {
      padding: 4 * t
      gap: 2 * t
      fill: true
      Row {
        gap: 4 * t
        align: center
        Icon { w: 7 * t; h: 8 * t }
        Text { text: "${user}@${host}"; fontSize: (5.5 * t) * textScale; font: mono; bold: true; color: hi; maxLines: 1; weight: 1 }
        Phosphor { size: 5.5 * t; chipW: 34 * t }
      }
      Tabs { size: 7 * t }
      Column {
        scroll: true
        gap: 2 * t
        weight: 1
        fill: width
        TabBody { size: 5.5 * t; keyW: 38 * t }
      }
      Row {
        gap: 4 * t
        align: center
        Text { text: "TAP FOR FULL READOUT"; fontSize: (5 * t) * textScale; font: mono; color: dim; maxLines: 1; weight: 1 }
        Cursor { k: t }
      }
    }
    Scanlines { }
    Sweep { }
  }

  // ── the screen: the full Pip-Boy readout ──
  screen {
    title: "pip-boy 3000"
    Box {
      fill: true
      background: bg
      clip: true
      Column {
        fill: true
        padding: 14
        gap: 10
        Row {
          gap: 12
          align: center
          Icon { }
          Column {
            gap: 2
            weight: 1
            Text { text: "ROBCO INDUSTRIES UNIFIED OPERATING SYSTEM"; fontSize: (7) * textScale; font: mono; color: dim; maxLines: 1 }
            Text { text: "PIP-BOY 3000"; fontSize: (18) * textScale; font: mono; bold: true; color: hi; maxLines: 1 }
            Text { text: "${user}@${host}"; fontSize: (9) * textScale; font: mono; color: dim; maxLines: 1 }
          }
          Column {
            gap: 2
            align: end
            Text { text: "PHOSPHOR"; fontSize: (7) * textScale; font: mono; color: dim; width: 64; align: end; maxLines: 1 }
            Phosphor { }
          }
        }

        Row {
          fill: width
          Text { text: "TEXT SIZE"; fontSize: 10; font: mono; color: dim; weight: 1 }
          Text { text: "[ ${round(textScale * 100)}% ]"; fontSize: 12; font: mono; color: main; border: 1; borderColor: edge; padding: [12, 8]; width: 100; align: center; onTap: textScale = textScale < 1.25 ? 1.25 : textScale < 1.5 ? 1.5 : 1 }
        }
        Tabs { }

        Column {
          scroll: true
          gap: 8
          weight: 1
          fill: width
          TabBody { }
        }

        Row {
          gap: 6
          align: center
          Text { text: "CRT ON"; fontSize: (8) * textScale; font: mono; color: dim; maxLines: 1; weight: 1 }
          Cursor { }
          Text {
            text: "[ CLOSE ]"
            fontSize: (9) * textScale
            font: mono
            bold: true
            color: main
            border: 1
            borderColor: edge
            radius: 3
            padding: [6, 3]
            width: 62
            align: center
            maxLines: 1
            onTap: close()
          }
        }
      }
      Scanlines { }
      Sweep { }
    }
  }
}
